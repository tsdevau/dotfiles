# Normalize `open` across Linux, macOS, and Windows.
if [[ ! $(uname -s) = "Darwin" ]]; then
  if grep -q Microsoft /proc/version; then
    # Ubuntu on Windows using the Linux subsystem
    alias open="explorer.exe"
  else
    alias open="xdg-open"
  fi
fi

# Recursively delete ".DS_Store" and ".dbxignore" files from the current directory.
rmdsdb() {
  if [[ $(uname -s) = "Darwin" ]]; then
    log_info "Removing .DS_Store and .dbxignore files from $(pwd)..."
    find . \( -name ".DS_Store" -o -name ".dbxignore" \) -type f -delete
    log_success "Removed .DS_Store and .dbxignore files"
  else
    log_error "This function is only applicable on macOS."
  fi
}

# Empty all Trash on all macOS mounted volumes.
trashall() {
  if [[ $(uname -s) = "Darwin" ]]; then
    log_header "Empty Trash on All Volumes"
    log_warn "This permanently deletes all Trash on mounted volumes and clears Apple System Logs."
    read "confirm?Are you sure you want to proceed? (y/N): "

    if [[ "$confirm" =~ ^[yY]$ ]]; then

      for volume in /Volumes/*; do
        if [[ -d "$volume/.Trashes" ]]; then
          log_info "Emptying Trash on $volume"
          sudo command rm -rf "$volume/.Trashes/"*
        else
          log_note "No Trash found on $volume"
        fi
      done
      log_success "All Trash emptied"

      log_info "Clearing all Apple System Logs..."
      sudo command rm -rf /private/var/log/asl/*.asl
      log_success "Apple System Logs cleared"

      # log_info "Clearing download history from Quarantine..."
      # sqlite3 "${HOME}/Library/Preferences/com.apple.LaunchServices.QuarantineEventsV*" 'delete from LSQuarantineEvent'
      # log_success "Download history cleared from Quarantine"

      log_done "Trash Cleanup Complete"
    else
      log_warn "Operation aborted by user."
    fi

  else
    log_error "This function is only applicable on macOS."
  fi
}
